{
  "project": "Enterprise AI Control Plane",
  "trainee": "Tukrim Sohorabil",
  "days": 14,
  "spend_cap_usd": 20,
  "protocol": {
    "one_part_at_a_time": true,
    "name_tool_and_why": true,
    "ask_before_paid_resources": true,
    "stop_and_wait_for": "next",
    "understanding_check_after_each_part": {
      "questions": [
        "What did we build and how does it connect to what already existed?",
        "Why this tool, and why not the obvious alternative?",
        "Use cases of this tool in our scenario, plus one real-world use case elsewhere"
      ],
      "wait_for_answers": true,
      "give_feedback": true,
      "reask_missed_idea_once": true,
      "user_can_skip": "skip check"
    },
    "progress_file": "PROGRESS.md",
    "status_triggers": [
      "where are we?",
      "status",
      "how far?"
    ],
    "status_format": [
      "Now",
      "Done",
      "Next",
      "Spend so far + running now",
      "Understanding checks",
      "Open issues"
    ],
    "status_max_lines": 8
  },
  "clouds": {
    "cloudflare": "edge + AI edge",
    "aws": "platform runtime + Claude via Bedrock",
    "gcp": "Gemini + BigQuery"
  },
  "eks_days": [
    9,
    13
  ],
  "telemetry_fields": [
    "request_id",
    "app",
    "provider",
    "model",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "cost_usd",
    "status",
    "fallback"
